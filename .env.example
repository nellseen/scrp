PORT=3000

# Telegram Userbot Credentials
# Get these from https://my.telegram.org
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=your_api_hash

# Telegram Control Bot (Optional, for admin commands)
# Get from @BotFather
BOT_TOKEN=your_bot_token
ADMIN_ID=your_telegram_user_id

# Target Channel for Completed Media (Optional, defaults to original chat if not set)
TARGET_CHANNEL_ID=-100123456789

# System Configuration
SESSION_SECRET=your_session_secret
WS_SECRET=your_websocket_secret
CONCURRENCY_LIMIT=3

# Storage Limits (%)
STORAGE_WARNING_THRESHOLD=85
STORAGE_CRITICAL_THRESHOLD=95

# Logging
LOG_LEVEL=info
